# ============================================================
#  Ferry — настройки релея.
#
#  Скопируйте в ferry.conf рядом (update.sh делает это сам) и правьте.
#  Всё закомментировано: работающие значения — это умолчания.
#
#  Сервер этот файл только ЧИТАЕТ. На диск он не пишет ничего и никогда:
#  ни логов раздач, ни временных файлов, ни базы.
#
#  Любую настройку можно задать и переменной окружения — она сильнее
#  файла: FERRY_TRANSFER_WINDOW_MB=128 в docker-compose.yml.
# ============================================================

[server]
# Имя инстанса. Видно в GET /api/health.
# name = Ferry

# Внешний адрес релея («https://ferry.example.ru»). Нужен, чтобы клиент
# собрал ссылку: за прокси сервер своего имени не знает. Пусто — клиент
# подставит тот адрес, по которому подключился сам.
# public_url =

[transfer]
# Окно на одну раздачу, МиБ. Это БУФЕР ДЖИТТЕРА, А НЕ КЭШ: при 100 МБ/с
# 256 МиБ покрывают две с половиной секунды разброса между получателями.
# Увеличивать имеет смысл, если получатели сильно разной скорости.
# window_mb = 256

# Глобальный потолок памяти под все окна, МиБ. При нехватке окна
# ужимаются, а новые раздачи получают server_busy — своп для релея хуже
# отказа, потому что утягивает за собой всех сразу.
# На VPS с 2 ГБ памяти разумно 1024; с 1 ГБ — 384.
# ram_budget_mb = 1024

# Сколько раздач живёт одновременно.
# max_transfers = 64

# Потолок получателей на раздачу. Отправитель может попросить меньше,
# больше — нет. Это защита от превращения вашего VPS в раздатчик для
# чужого форума.
# max_concurrent = 8

# Срок жизни раздачи по умолчанию и максимальный, секунды.
# default_ttl_s = 86400
# max_ttl_s = 604800

[limits]
# Анти-абьюз без хранения: счётчики в оперативке, никакой истории,
# всё обнуляется при перезапуске.
# create_per_ip_per_min = 10
# max_transfers_per_ip = 8

[web]
# Раздавать ли страницы и установщик клиента. false — остаётся только
# JSON API и вебсокет-релей.
# enabled = true

[log]
# off | errors | normal
#
# Умолчание — errors, и это сознательно: идентификатор раздачи, адрес и
# имя получателя — ровно то, чего мы обещали не хранить, а stdout в докере
# оседает в `docker logs` навсегда. normal включайте на время отладки.
# level = errors
